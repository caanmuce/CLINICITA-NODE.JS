# Copia este archivo como .env y completa solo lo necesario.
TOKEN_SECRET=cambia-esta-clave-en-produccion

# WhatsApp: false por defecto. Usa true para activar el bot y escanear el QR.
ENABLE_WHATSAPP=false

# Opcional: habilita clasificación y respuestas generales con Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ENABLE_WHATSAPP_CHATBOT=true

# ML Service para score de riesgo no-show
ML_SERVICE_URL=http://localhost:8001