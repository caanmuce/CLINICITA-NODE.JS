# Este es un proyecto formativo: usa valores de desarrollo/local.

# ==================== BASE DE DATOS ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinicitabd

# ==================== AUTENTICACIÓN ====================
# IMPORTANTE: Cambia esta clave en producción por una cadena aleatoria larga y segura
TOKEN_SECRET=clinicita-clave-local-cambiar-en-produccion

# ==================== SERVIDOR ====================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ==================== SERVICIO ML (Python) ====================
# URL del microservicio de Machine Learning para score de riesgo no-show
ML_SERVICE_URL=http://localhost:8000

# ==================== WHATSAPP ====================
# WhatsApp: false por defecto. Usa true para activar el bot y escanear el QR.
# ENABLE_WHATSAPP activa/desactiva la integración general de WhatsApp (envío de mensajes, escaneo QR).
ENABLE_WHATSAPP=false
# ENABLE_WHATSAPP_CHATBOT activa/desactiva específicamente el chatbot automatizado de WhatsApp.
# Es independiente de ENABLE_WHATSAPP: se puede tener WhatsApp habilitado sin chatbot, y viceversa.
ENABLE_WHATSAPP_CHATBOT=false
# En pruebas, el chatbot solo responde a pacientes con un recordatorio enviado.
WHATSAPP_ONLY_REMINDER_RECIPIENTS=true
WHATSAPP_INIT_RETRIES=3
WHATSAPP_INIT_TIMEOUT_SECONDS=90

# ==================== GEMINI (Opcional) ====================
# Opcional: habilita clasificación y respuestas generales con Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ==================== ZONA HORARIA ====================
CLINIC_TIMEZONE=America/Bogota
CLINIC_UTC_OFFSET=-05:00

# ==================== RATE LIMITING ====================
# Máximo intentos de login/registro por IP cada 15 min (50 en dev, 5 en prod)
AUTH_RATE_LIMIT_MAX=50

# ==================== SERVICIOS ADICIONALES ====================
# Opcional: habilita clasificación y respuestas generales mediante OmniRoute.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=combo-1
DEVELOPER_MODE=false

# SMS (mock por defecto; android_gateway o twilio en producción)
SMS_PROVIDER=android_gateway
SMS_GATEWAY_URL=http://192.168.128.4:8080
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_COUNTRY_CODE=57
# Minutos disponibles para aceptar una oferta de lista de espera (mínimo 5).
LISTA_ESPERA_TTL_MINUTOS=30

# ==================== SERVICIO ML (Seguridad interna backend ↔ ML) ====================
# Clave compartida entre el backend Node.js y el servicio ML (FastAPI).
# Configurar en .env (local) o en el entorno de producción. Nunca incluir valor real aquí.
ML_SERVICE_SECRET_KEY=
