# Copia este archivo como .env y completa solo lo necesario.
TOKEN_SECRET=cambia-esta-clave-en-produccion

# WhatsApp: false por defecto. Usa true para activar el bot y escanear el QR.
ENABLE_WHATSAPP=false
# En pruebas, el chatbot solo responde a pacientes con un recordatorio enviado.
WHATSAPP_ONLY_REMINDER_RECIPIENTS=true
WHATSAPP_INIT_RETRIES=3
WHATSAPP_INIT_TIMEOUT_SECONDS=90

# Opcional: habilita clasificación y respuestas generales mediante OmniRoute.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=combo-1
ENABLE_WHATSAPP_CHATBOT=true
DEVELOPER_MODE=false

# ML Service para score de riesgo no-show
ML_SERVICE_URL=http://localhost:8001

# SMS (mock por defecto; android_gateway o twilio en producción)
SMS_PROVIDER=android_gateway
SMS_GATEWAY_URL=http://192.168.128.4:8080
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_COUNTRY_CODE=57
