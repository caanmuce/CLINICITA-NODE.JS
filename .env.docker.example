MYSQL_ROOT_PASSWORD=clinicita123
DB_NAME=clinicitabd
DB_USER=root
TOKEN_SECRET=cambia-esta-clave-local
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
ENABLE_WHATSAPP=false
ENABLE_WHATSAPP_CHATBOT=false
DEVELOPER_MODE=false
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_MODEL=combo-1
CLINIC_TIMEZONE=America/Bogota
CLINIC_UTC_OFFSET=-05:00

# SMS: mock por defecto; para Android Gateway configura URL/usuario/contraseña
SMS_PROVIDER=android_gateway
SMS_GATEWAY_URL=http://192.168.128.4:8080
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Minutos disponibles para aceptar una oferta de lista de espera (mínimo 5).
LISTA_ESPERA_TTL_MINUTOS=30

# ==================== SERVICIO ML (Seguridad interna backend ↔ ML) ====================
# Clave compartida entre el backend Node.js y el servicio ML (FastAPI).
# Configurar en el entorno de producción. Nunca incluir valor real aquí.
ML_SERVICE_SECRET_KEY=
