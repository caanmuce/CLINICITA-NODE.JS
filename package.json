{
  "name": "clinicita-nodejs",
  "private": true,
  "scripts": {
    "start": "node server\\server.js",
    "lint": "eslint server test_server.js public\\assets\\js",
    "format": "prettier --write package.json eslint.config.mjs",
    "format:check": "prettier --check package.json eslint.config.mjs",
    "check:node": "node --check server\\server.js && node --check server\\conexion.js && node --check server\\services\\ml-client.js && node --check server\\servicios\\whatsapp.js && node --check test_server.js",
    "check:python": "python -m py_compile ml-service\\app\\main.py ml-service\\app\\model\\predictor.py ml-service\\scripts\\generate_training_data.py ml-service\\train.py",
    "test": "npm run check:node && npm run check:python && npm run test:smoke",
    "test:smoke": "node test_server.js",
    "build": "docker compose config --quiet && docker compose build",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.4",
    "node-cron": "^4.2.1",
    "playwright": "^1.64.1",
    "qrcode-terminal": "^0.12.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "whatsapp-web.js": "^1.34.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "node@26.8.2": true,
    "protobufjs@7.6.6": true,
    "puppeteer@24.38.0": true,
    "@google/genai@1.52.0": true
  }
}
